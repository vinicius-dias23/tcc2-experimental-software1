# Copie para .env e ajuste. O docker compose e os scripts Python leem este arquivo.

# Pasta com os CSVs do Olist (use ./ no início para caminhos relativos).
OLIST_DATA_DIR=./data/olist
# Fração dos pedidos gravada direto nas bases antes dos testes; o restante vira carga pela API.
SEED_FRACTION=0.7

# Software A (Domain Events): tempo máximo que a requisição espera o broker confirmar o evento
# e resposta ao cliente quando a publicação falha após o commit (success ou error).
PUBLISH_TIMEOUT=5s
PUBLISH_MAX_ATTEMPTS=10
PUBLISH_FAILURE_RESPONSE=success

# Software B (CDC): intervalo de gravação de offsets do Kafka Connect e tempo máximo de
# entrega do produtor do Connect (o máximo evita que a tarefa falhe em janelas longas).
CDC_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_PRODUCER_DELIVERY_TIMEOUT_MS=2147483647

# Comum
KAFKA_PARTITIONS=6
CONSUMER_WORKERS=3
